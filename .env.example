# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── x402 Payments (real USDC on Base) ──
# Get CDP keys from https://www.coinbase.com/developer-platform
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
DOJO_PLATFORM_WALLET=0xYourWalletAddress
DOJO_NETWORK=base-sepolia
DOJO_MOCK_PAYMENTS=false

# ── LLM for Training (optional — falls back to scripted responses) ──
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
