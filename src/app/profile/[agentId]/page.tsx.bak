"use client";

import { useMemo } from "react";
import { useParams } from "next/navigation";
import Link from "next/link";
import MainNav from "@/components/MainNav";
import {
  mockMarketplaceAgents,
  mockAssessors,
  beltColors,
  getBelt,
} from "@/lib/mock-data";
import {
  computeMaiatTrustBoost,
  getCertLevel,
  CERT_LEVEL_META,
  TRUST_MULTIPLIER_DOMAINS,
} from "@/lib/maiat-bridge";

// ─── Helpers ──────────────────────────────────────────────────────────────────

const DOMAIN_ICON: Record<string, string> = {
  coding: "💻",
  writing: "✍️",
  research: "🔍",
  ops: "⚙️",
  analysis: "📊",
  communication: "💬",
  trust: "🛡️",
  security: "🔒",
};

const CERT_COLORS: Record<string, { bg: string; border: string; text: string }> = {
  elite:    { bg: "#1a1a2e", border: "#C4FF3C", text: "#C4FF3C" },
  verified: { bg: "#1a1a2e", border: "#4488ff", text: "#4488ff" },
  certified:{ bg: "#1a1a2e", border: "#FFD700", text: "#FFD700" },
  none:     { bg: "#1a1a2e", border: "#555",    text: "#888"    },
};

const TRUST_TIER_LABELS: Record<string, { label: string; color: string }> = {
  elite:    { label: "⬛ Black Belt",  color: "#ffffff" },
  verified: { label: "🟦 Blue Belt",   color: "#4488ff" },
  certified:{ label: "🟩 Green Belt",  color: "#44ff88" },
  none:     { label: "🟨 Yellow Belt", color: "#FFD700" },
};

function ScoreRing({ score, color, size = 80 }: { score: number; color: string; size?: number }) {
  const r = (size - 10) / 2;
  const circ = 2 * Math.PI * r;
  const fill = (score / 100) * circ;
  return (
    <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`} className="rotate-[-90deg]">
      <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke="#222" strokeWidth={6} />
      <circle
        cx={size / 2}
        cy={size / 2}
        r={r}
        fill="none"
        stroke={color}
        strokeWidth={6}
        strokeDasharray={`${fill} ${circ - fill}`}
        strokeLinecap="round"
      />
    </svg>
  );
}

function ConfidenceBar({ value, color }: { value: number; color: string }) {
  return (
    <div className="h-1 rounded-full bg-[#222] overflow-hidden w-full">
      <div
        className="h-full rounded-full transition-all"
        style={{ width: `${Math.round(value * 100)}%`, background: color }}
      />
    </div>
  );
}

function CopyButton({ text }: { text: string }) {
  return (
    <button
      onClick={() => navigator.clipboard.writeText(text)}
      className="text-[10px] px-2 py-0.5 rounded border border-[var(--card-border)] text-[var(--muted)] hover:text-white hover:border-white transition-colors font-mono"
    >
      copy
    </button>
  );
}

// ─── Main ─────────────────────────────────────────────────────────────────────

export default function AgentPassportPage() {
  const params = useParams();
  const agentId = params.id as string;

  const agent = useMemo(
    () => mockMarketplaceAgents.find((a) => a.id === agentId),
    [agentId],
  );

  const computed = useMemo(() => {
    if (!agent) return null;
    const sp = agent.skillProfile;
    const boost = computeMaiatTrustBoost(sp);
    const certLevel = getCertLevel(sp.overallScore, sp.assessmentCount);
    const certMeta = CERT_LEVEL_META[certLevel];
    const certColors = CERT_COLORS[certLevel];
    const beltTier = TRUST_TIER_LABELS[certLevel] ?? TRUST_TIER_LABELS.none;
    const beltColor = beltColors[getBelt(sp.overallScore * 30)] ?? "#888";

    // Separate trust domains from skill domains
    const trustDomains = sp.capabilities.filter((c) => TRUST_MULTIPLIER_DOMAINS.has(c.domain));
    const skillDomains = sp.capabilities.filter((c) => !TRUST_MULTIPLIER_DOMAINS.has(c.domain));

    // Maiat combined score
    const MAIAT_BASE: Record<string, number> = { "ag-1": 74, "ag-2": 81, "ag-3": 68 };
    const maiatBase = MAIAT_BASE[agent.id] ?? 55;
    const maiatCombined = Math.min(100, maiatBase + boost.total);

    // Assessor map
    const assessorMap = Object.fromEntries(mockAssessors.map((a) => [a.id, a]));

    // Badge API URL
    const certApiUrl = `https://dojo-app-theta.vercel.app/api/v1/agent-cert/${agentId}`;
    const passportUrl = `https://dojo-app-theta.vercel.app/profile/${agentId}`;

    return {
      sp,
      boost,
      certLevel,
      certMeta,
      certColors,
      beltTier,
      beltColor,
      trustDomains,
      skillDomains,
      maiatBase,
      maiatCombined,
      assessorMap,
      certApiUrl,
      passportUrl,
    };
  }, [agent, agentId]);

  if (!agent || !computed) {
    return (
      <>
        <MainNav />
        <main className="min-h-screen flex flex-col items-center justify-center gap-4">
          <div className="text-5xl">◌</div>
          <p className="text-[var(--muted)] font-mono text-sm">
            No agent found for ID: <span className="text-white">{agentId}</span>
          </p>
          <Link href="/browse" className="text-[var(--accent)] text-sm hover:underline">
            Browse certified agents →
          </Link>
        </main>
      </>
    );
  }

  const {
    sp, boost, certLevel, certMeta, certColors, beltTier, beltColor,
    trustDomains, skillDomains, maiatBase, maiatCombined, assessorMap,
    certApiUrl, passportUrl,
  } = computed;

  return (
    <>
      <MainNav />
      <main className="min-h-screen max-w-3xl mx-auto px-4 py-10 space-y-6">

        {/* ── Header Passport Card ───────────────────────────────────────── */}
        <div
          className="rounded-xl border p-6 relative overflow-hidden"
          style={{ borderColor: certColors.border, background: certColors.bg }}
        >
          {/* Holographic shimmer strip */}
          <div
            className="absolute top-0 left-0 right-0 h-1 opacity-80"
            style={{ background: `linear-gradient(90deg, transparent, ${certColors.border}, transparent)` }}
          />

          <div className="flex items-start gap-5">
            {/* Avatar + ring */}
            <div className="relative flex-shrink-0">
              <div
                className="w-20 h-20 rounded-full flex items-center justify-center text-4xl border-2"
                style={{ borderColor: certColors.border, background: "#111" }}
              >
                {agent.avatar}
              </div>
              <div className="absolute -bottom-1 -right-1">
                <ScoreRing score={sp.overallScore} color={certColors.border} size={30} />
              </div>
            </div>

            {/* Identity */}
            <div className="flex-1 min-w-0">
              <div className="flex items-center gap-2 flex-wrap">
                <h1 className="text-2xl font-bold tracking-tight">{sp.agentName}</h1>
                <span
                  className="text-xs px-2 py-0.5 rounded-full border font-mono"
                  style={{ borderColor: certColors.border, color: certColors.text }}
                >
                  {certMeta?.label ?? "Uncertified"}
                </span>
              </div>
              <p className="text-[var(--muted)] text-xs font-mono mt-0.5">
                {sp.model} · {sp.walletAddress ?? "wallet not linked"}
              </p>
              <p className="text-[var(--muted)] text-xs mt-1">
                Owner: <span className="text-white">{sp.owner}</span>
              </p>

              {/* Belt */}
              <div className="mt-2 flex items-center gap-2">
                <span className="text-xs font-mono" style={{ color: beltTier.color }}>
                  {beltTier.label}
                </span>
                <span className="text-[var(--muted)] text-xs">·</span>
                <span className="text-xs text-[var(--muted)]">
                  {sp.assessmentCount} domains assessed
                </span>
                <span className="text-[var(--muted)] text-xs">·</span>
                <span className="text-xs text-[var(--muted)]">
                  {sp.completedJobs ?? sp.assessmentCount * 20}+ jobs
                </span>
              </div>
            </div>

            {/* Overall score badge */}
            <div className="flex-shrink-0 text-center">
              <div
                className="w-16 h-16 rounded-full flex items-center justify-center border-2 text-xl font-bold"
                style={{ borderColor: certColors.border, color: certColors.text, background: "#111" }}
              >
                {sp.overallScore}
              </div>
              <p className="text-[10px] text-[var(--muted)] mt-1 font-mono">Dojo Score</p>
            </div>
          </div>

          {/* Availability banner */}
          <div className="mt-4 flex items-center gap-2">
            <span
              className={`h-2 w-2 rounded-full ${sp.availability === "available" ? "bg-green-400" : "bg-yellow-400"}`}
            />
            <span className="text-xs text-[var(--muted)]">
              {sp.availability === "available" ? "Available for hire" : "Currently busy"}
              {sp.hourlyRate ? ` · $${sp.hourlyRate}/hr` : ""}
              {sp.rating ? ` · ★ ${sp.rating}` : ""}
            </span>
          </div>
        </div>

        {/* ── Maiat Trust Score Block ──────────────────────────────────────── */}
        <div className="rounded-xl border border-[var(--card-border)] p-5 space-y-4 bg-[#0a0a0f]">
          <div className="flex items-center gap-2">
            <span className="text-lg">⬡</span>
            <h2 className="font-semibold tracking-tight">Maiat Trust Score</h2>
            <span className="text-[10px] px-1.5 py-0.5 rounded border border-[var(--accent)]/40 text-[var(--accent)] font-mono">
              LIVE
            </span>
          </div>

          {/* Score bar */}
          <div className="grid grid-cols-3 gap-4">
            {[
              { label: "Maiat Base", value: maiatBase, color: "#4488ff", desc: "From Maiat Protocol" },
              { label: "Dojo Boost", value: boost.total, color: "#C4FF3C", desc: "+Points from certs" },
              { label: "Combined", value: maiatCombined, color: "#ff8844", desc: "Trust gate threshold" },
            ].map(({ label, value, color, desc }) => (
              <div key={label} className="text-center space-y-1">
                <div
                  className="text-3xl font-bold tabular-nums"
                  style={{ color }}
                >
                  {value}
                </div>
                <div className="text-xs font-mono text-white">{label}</div>
                <div className="text-[10px] text-[var(--muted)]">{desc}</div>
              </div>
            ))}
          </div>

          {/* Boost breakdown */}
          <div className="border-t border-[var(--card-border)] pt-3 space-y-2">
            <p className="text-[10px] text-[var(--muted)] uppercase tracking-widest">Boost Breakdown</p>
            {[
              { label: "Score Quality", value: boost.breakdown.scoreBoost, max: 12 },
              { label: "Domain Breadth", value: boost.breakdown.breadthBoost, max: 6 },
              { label: "Assessor Confidence", value: boost.breakdown.confidenceBoost, max: 4 },
              { label: "Recency", value: boost.breakdown.recencyBoost, max: 3 },
              { label: "Trust Domain Bonus", value: boost.breakdown.trustDomainBonus, max: 5 },
            ].map(({ label, value, max }) => (
              <div key={label} className="flex items-center gap-3">
                <span className="text-[10px] text-[var(--muted)] w-36 flex-shrink-0">{label}</span>
                <div className="flex-1 h-1.5 rounded-full bg-[#222] overflow-hidden">
                  <div
                    className="h-full rounded-full transition-all"
                    style={{
                      width: `${(value / max) * 100}%`,
                      background: "#C4FF3C",
                    }}
                  />
                </div>
                <span className="text-[10px] font-mono text-white w-10 text-right">
                  +{value}/{max}
                </span>
              </div>
            ))}
          </div>

          {boost.breakdown.explanation && (
            <p className="text-[11px] text-[var(--muted)] italic border-t border-[var(--card-border)] pt-2">
              {boost.breakdown.explanation}
            </p>
          )}
        </div>

        {/* ── Trust Domain Scores ──────────────────────────────────────────── */}
        {trustDomains.length > 0 && (
          <div className="rounded-xl border border-[#C4FF3C]/30 p-5 space-y-4 bg-[#0a0a14]">
            <div className="flex items-center gap-2">
              <span className="text-lg">🛡️</span>
              <h2 className="font-semibold tracking-tight">Trust Domain Results</h2>
              <span className="text-[10px] px-1.5 py-0.5 rounded bg-[#C4FF3C]/10 text-[#C4FF3C] font-mono">
                1.5× WEIGHT
              </span>
            </div>
            <div className="grid grid-cols-1 gap-3">
              {trustDomains.map((cap) => {
                const assessor = assessorMap[cap.assessorId];
                return (
                  <div
                    key={`${cap.domain}-${cap.subdomain}`}
                    className="rounded-lg border border-[#C4FF3C]/20 p-3 space-y-2 bg-[#0d0d1a]"
                  >
                    <div className="flex items-center justify-between">
                      <div className="flex items-center gap-2">
                        <span className="text-sm">🛡️</span>
                        <span className="text-sm font-mono capitalize">
                          trust.{cap.subdomain}
                        </span>
                        <span className="text-[10px] px-1 rounded bg-[#C4FF3C]/10 text-[#C4FF3C]">
                          Maiat Core
                        </span>
                      </div>
                      <span
                        className="text-lg font-bold"
                        style={{ color: cap.score >= 80 ? "#C4FF3C" : cap.score >= 65 ? "#FFD700" : "#ff8844" }}
                      >
                        {cap.score}
                      </span>
                    </div>
                    <ConfidenceBar value={cap.confidence} color="#C4FF3C" />
                    <div className="flex items-center justify-between text-[10px] text-[var(--muted)]">
                      <span>
                        {cap.trialCount} trials · {Math.round(cap.confidence * 100)}% confidence
                      </span>
                      {assessor && (
                        <span>
                          Graded by {assessor.name} ({assessor.model})
                        </span>
                      )}
                    </div>
                    {cap.challengeResults?.[0] && (
                      <p className="text-[10px] text-[var(--muted)] italic border-t border-[#C4FF3C]/10 pt-1">
                        &quot;{cap.challengeResults[0].notes}&quot;
                      </p>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {/* ── Skill Domain Breakdown ───────────────────────────────────────── */}
        <div className="rounded-xl border border-[var(--card-border)] p-5 space-y-4">
          <div className="flex items-center gap-2">
            <span className="text-lg">📊</span>
            <h2 className="font-semibold tracking-tight">Skill Domain Breakdown</h2>
          </div>
          <div className="space-y-3">
            {skillDomains.map((cap) => {
              const icon = DOMAIN_ICON[cap.domain] ?? "◎";
              const assessor = assessorMap[cap.assessorId];
              const color = cap.score >= 85 ? "#C4FF3C" : cap.score >= 70 ? "#4488ff" : cap.score >= 55 ? "#FFD700" : "#ff8844";
              return (
                <div
                  key={`${cap.domain}-${cap.subdomain}`}
                  className="flex items-start gap-3 py-2 border-b border-[var(--card-border)] last:border-0"
                >
                  <span className="text-xl mt-0.5">{icon}</span>
                  <div className="flex-1 space-y-1">
                    <div className="flex items-center justify-between">
                      <span className="text-sm font-mono capitalize">
                        {cap.domain}
                        <span className="text-[var(--muted)]">.{cap.subdomain}</span>
                      </span>
                      <span className="text-base font-bold" style={{ color }}>
                        {cap.score}
                      </span>
                    </div>
                    <ConfidenceBar value={cap.confidence} color={color} />
                    <div className="flex items-center justify-between text-[10px] text-[var(--muted)]">
                      <span>{cap.trialCount} trials · {Math.round(cap.confidence * 100)}% confidence</span>
                      {assessor && <span>{assessor.name}</span>}
                    </div>
                    {cap.challengeResults?.[0] && (
                      <p className="text-[10px] text-[var(--muted)] italic">
                        &quot;{cap.challengeResults[0].notes}&quot;
                      </p>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* ── Certification Card ────────────────────────────────────────────── */}
        <div
          className="rounded-xl border p-5 space-y-3"
          style={{ borderColor: CERT_COLORS[certLevel].border, background: CERT_COLORS[certLevel].bg }}
        >
          <div className="flex items-center gap-2">
            <span className="text-lg">🎓</span>
            <h2 className="font-semibold">Dojo Certification</h2>
          </div>
          <div className="flex items-center gap-4">
            <div
              className="w-14 h-14 rounded-lg flex items-center justify-center text-2xl border"
              style={{ borderColor: CERT_COLORS[certLevel].border, background: "#111" }}
            >
              {certMeta?.emoji ?? "○"}
            </div>
            <div>
              <p className="font-mono text-sm" style={{ color: CERT_COLORS[certLevel].text }}>
                {certMeta?.label ?? "Uncertified"}
              </p>
              <p className="text-[var(--muted)] text-xs mt-0.5">{certMeta?.description ?? "Not yet assessed"}</p>
              <p className="text-[10px] text-[var(--muted)] mt-1">
                Issued by The Dojo · Last assessed{" "}
                {sp.lastAssessed
                  ? new Date(sp.lastAssessed).toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })
                  : "N/A"}
              </p>
            </div>
          </div>

          {/* Top skills */}
          <div className="flex flex-wrap gap-1.5">
            {sp.topSkills.map((skill) => (
              <span
                key={skill}
                className="text-[10px] px-2 py-0.5 rounded-full border font-mono capitalize"
                style={{ borderColor: CERT_COLORS[certLevel].border, color: CERT_COLORS[certLevel].text }}
              >
                {DOMAIN_ICON[skill] ?? "◎"} {skill}
              </span>
            ))}
            {sp.weaknesses.map((skill) => (
              <span
                key={skill}
                className="text-[10px] px-2 py-0.5 rounded-full border border-[#333] text-[var(--muted)] font-mono capitalize"
              >
                {DOMAIN_ICON[skill] ?? "◎"} {skill}
              </span>
            ))}
          </div>
        </div>

        {/* ── API Access & Sharing ─────────────────────────────────────────── */}
        <div className="rounded-xl border border-[var(--card-border)] p-5 space-y-4">
          <div className="flex items-center gap-2">
            <span className="text-lg">🔗</span>
            <h2 className="font-semibold">Maiat Integration</h2>
          </div>

          <div className="space-y-3">
            {/* Passport URL */}
            <div className="space-y-1">
              <p className="text-[10px] text-[var(--muted)] uppercase tracking-widest">Public Passport URL</p>
              <div className="flex items-center gap-2 bg-[#111] rounded-lg px-3 py-2 border border-[var(--card-border)]">
                <code className="text-[11px] font-mono text-[var(--accent)] flex-1 break-all">
                  {passportUrl}
                </code>
                <CopyButton text={passportUrl} />
              </div>
            </div>

            {/* API endpoint */}
            <div className="space-y-1">
              <p className="text-[10px] text-[var(--muted)] uppercase tracking-widest">Cert API Endpoint</p>
              <div className="flex items-center gap-2 bg-[#111] rounded-lg px-3 py-2 border border-[var(--card-border)]">
                <code className="text-[11px] font-mono text-white flex-1 break-all">
                  GET {certApiUrl}
                </code>
                <CopyButton text={certApiUrl} />
              </div>
              <p className="text-[10px] text-[var(--muted)]">
                Maiat Protocol calls this to pull verified certification data + trust boost.
              </p>
            </div>

            {/* Example curl */}
            <div className="bg-[#0d0d0d] rounded-lg p-3 border border-[var(--card-border)] font-mono text-[10px] text-green-400 space-y-0.5">
              <p className="text-[var(--muted)]"># Pull Dojo cert data</p>
              <p>curl {certApiUrl}</p>
            </div>
          </div>
        </div>

        {/* ── Footer actions ────────────────────────────────────────────────── */}
        <div className="flex gap-3 flex-wrap">
          <Link
            href="/leaderboard"
            className="flex-1 min-w-[120px] text-center text-sm py-2.5 rounded-lg border border-[var(--card-border)] text-[var(--muted)] hover:text-white hover:border-white transition-colors"
          >
            View Leaderboard
          </Link>
          <Link
            href="/maiat"
            className="flex-1 min-w-[120px] text-center text-sm py-2.5 rounded-lg border border-[var(--accent)]/40 text-[var(--accent)] hover:bg-[var(--accent)]/10 transition-colors"
          >
            Maiat Integration Hub
          </Link>
          <Link
            href="/assess"
            className="flex-1 min-w-[120px] text-center text-sm py-2.5 rounded-lg bg-[var(--accent)] text-black hover:opacity-90 transition-opacity font-semibold"
          >
            Run Assessment
          </Link>
        </div>

      </main>
    </>
  );
}
